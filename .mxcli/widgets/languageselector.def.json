{
  "widgetId": "com.mendix.widget.web.languageselector.LanguageSelector",
  "mdlName": "LANGUAGESELECTOR",
  "widgetKind": "pluggable",
  "templateFile": "languageselector.json",
  "defaultEditable": "Always",
  "generatorVersion": 17,
  "propertyMappings": [
    {
      "propertyKey": "languageOptions",
      "source": "DataSource",
      "operation": "datasource",
      "description": "Recommended: Database data source with System.Language as entity."
    },
    {
      "propertyKey": "position",
      "value": "bottom",
      "operation": "primitive",
      "description": "The location of the menu relative to the current selected language (click area)."
    },
    {
      "propertyKey": "trigger",
      "value": "click",
      "operation": "primitive"
    },
    {
      "propertyKey": "hideForSingle",
      "value": "true",
      "operation": "primitive"
    },
    {
      "propertyKey": "screenReaderLabelCaption",
      "source": "TextTemplate",
      "operation": "texttemplate",
      "description": "Assistive technology will read this upon reaching the input element."
    }
  ],
  "knownProperties": [
    "languageCaption"
  ]
}
