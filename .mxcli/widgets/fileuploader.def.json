{
  "widgetId": "com.mendix.widget.web.fileuploader.FileUploader",
  "mdlName": "FILEUPLOADER",
  "widgetKind": "pluggable",
  "templateFile": "fileuploader.json",
  "defaultEditable": "Always",
  "generatorVersion": 17,
  "propertyMappings": [
    {
      "propertyKey": "uploadMode",
      "value": "files",
      "operation": "primitive"
    },
    {
      "propertyKey": "associatedFiles",
      "source": "DataSource",
      "operation": "datasource"
    },
    {
      "propertyKey": "associatedImages",
      "source": "DataSource",
      "operation": "datasource"
    },
    {
      "propertyKey": "readOnlyMode",
      "value": "false",
      "operation": "primitive"
    },
    {
      "propertyKey": "createFileAction",
      "operation": "action",
      "description": "Nanoflow that creates a file object, associates it to the current object and commits it."
    },
    {
      "propertyKey": "createImageAction",
      "operation": "action",
      "description": "Nanoflow that creates an image object, associates it to the current object and commits it."
    },
    {
      "propertyKey": "maxFilesPerUpload",
      "value": "10",
      "operation": "primitive",
      "description": "Limit the number of files per one upload."
    },
    {
      "propertyKey": "maxFileSize",
      "value": "25",
      "operation": "primitive",
      "description": "Reject files that are bigger than specified size."
    },
    {
      "propertyKey": "dropzoneIdleMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "dropzoneAcceptedMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "dropzoneRejectedMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "uploadInProgressMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "uploadSuccessMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "uploadFailureGenericMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "uploadFailureInvalidFileFormatMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "uploadFailureFileIsTooBigMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "uploadFailureTooManyFilesMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "unavailableCreateActionMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "downloadButtonTextMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "removeButtonTextMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "removeSuccessMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "removeErrorMessage",
      "source": "TextTemplate",
      "operation": "texttemplate"
    },
    {
      "propertyKey": "objectCreationTimeout",
      "value": "10",
      "operation": "primitive",
      "description": "Consider uploads unsuccessful if the Action to create new files/images does not create new objects within the configured amount of seconds."
    },
    {
      "propertyKey": "enableCustomButtons",
      "value": "false",
      "operation": "primitive"
    }
  ],
  "objectLists": [
    {
      "propertyKey": "allowedFileFormats",
      "mdlContainer": "ALLOWEDFILEFORMAT",
      "itemProperties": [
        {
          "propertyKey": "configMode",
          "value": "simple",
          "operation": "primitive",
          "enumValues": [
            "simple",
            "advanced"
          ]
        },
        {
          "propertyKey": "predefinedType",
          "value": "pdfFile",
          "operation": "primitive",
          "enumValues": [
            "pdfFile",
            "msWordFile",
            "msExcelFile",
            "msPowerPointFile",
            "plainTextFile",
            "csvFile",
            "zipArchiveFile",
            "anyTextFile",
            "anyImageFile",
            "anyAudioFile",
            "anyVideoFile"
          ]
        },
        {
          "propertyKey": "mimeType",
          "operation": "primitive",
          "description": "For example 'image/jpeg' or 'application/pdf'"
        },
        {
          "propertyKey": "extensions",
          "operation": "primitive",
          "description": "Comma separated list of extensions. For example: '.jpg,.jpeg'."
        },
        {
          "propertyKey": "typeFormatDescription",
          "operation": "texttemplate",
          "description": "Shown to the end users to describe supported file types."
        }
      ]
    },
    {
      "propertyKey": "customButtons",
      "mdlContainer": "CUSTOMBUTTON",
      "itemProperties": [
        {
          "propertyKey": "buttonCaption",
          "operation": "texttemplate"
        },
        {
          "propertyKey": "buttonActionFile",
          "operation": "action",
          "dataSource": "../associatedFiles"
        },
        {
          "propertyKey": "buttonActionImage",
          "operation": "action",
          "dataSource": "../associatedImages"
        },
        {
          "propertyKey": "buttonIsDefault",
          "value": "false",
          "operation": "primitive",
          "description": "When set to Yes, the action will be triggered by clicking on the file entry."
        },
        {
          "propertyKey": "buttonIsVisible",
          "operation": "expression",
          "description": "The button will be hidden when false is returned."
        }
      ]
    }
  ],
  "propertyVisibility": [
    {
      "propertyKey": "associatedImages",
      "hiddenWhen": {
        "propertyKey": "uploadMode",
        "operator": "eq",
        "value": "files"
      }
    },
    {
      "propertyKey": "associatedFiles",
      "hiddenWhen": {
        "propertyKey": "uploadMode",
        "operator": "ne",
        "value": "files"
      }
    },
    {
      "propertyKey": "createImageAction",
      "hiddenWhen": {
        "propertyKey": "readOnlyMode",
        "operator": "truthy"
      }
    },
    {
      "propertyKey": "createFileAction",
      "hiddenWhen": {
        "propertyKey": "readOnlyMode",
        "operator": "truthy"
      }
    },
    {
      "propertyKey": "allowedFileFormats",
      "hiddenWhen": {
        "propertyKey": "readOnlyMode",
        "operator": "truthy"
      }
    },
    {
      "propertyKey": "maxFilesPerUpload",
      "hiddenWhen": {
        "propertyKey": "readOnlyMode",
        "operator": "truthy"
      }
    },
    {
      "propertyKey": "maxFileSize",
      "hiddenWhen": {
        "propertyKey": "readOnlyMode",
        "operator": "truthy"
      }
    },
    {
      "propertyKey": "objectCreationTimeout",
      "hiddenWhen": {
        "propertyKey": "readOnlyMode",
        "operator": "truthy"
      }
    },
    {
      "propertyKey": "mimeType",
      "listPropertyKey": "allowedFileFormats",
      "hiddenWhen": {
        "propertyKey": "configMode",
        "operator": "eq",
        "value": "simple",
        "scope": "item"
      }
    },
    {
      "propertyKey": "extensions",
      "listPropertyKey": "allowedFileFormats",
      "hiddenWhen": {
        "propertyKey": "configMode",
        "operator": "eq",
        "value": "simple",
        "scope": "item"
      }
    },
    {
      "propertyKey": "typeFormatDescription",
      "listPropertyKey": "allowedFileFormats",
      "hiddenWhen": {
        "propertyKey": "configMode",
        "operator": "eq",
        "value": "simple",
        "scope": "item"
      }
    },
    {
      "propertyKey": "predefinedType",
      "listPropertyKey": "allowedFileFormats",
      "hiddenWhen": {
        "propertyKey": "configMode",
        "operator": "ne",
        "value": "simple",
        "scope": "item"
      }
    },
    {
      "propertyKey": "customButtons",
      "hiddenWhen": {
        "propertyKey": "enableCustomButtons",
        "operator": "falsy"
      }
    }
  ]
}
