CREATE MEMORY TABLE PUBLIC."administration$account"("id" BIGINT NOT NULL PRIMARY KEY,"fullname" VARCHAR(200) COLLATE INFORMATION_SCHEMA.SQL_TEXT_UCC,"email" VARCHAR(200) COLLATE INFORMATION_SCHEMA.SQL_TEXT_UCC,"islocaluser" BOOLEAN)
