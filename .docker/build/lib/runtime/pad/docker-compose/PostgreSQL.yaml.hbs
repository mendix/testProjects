{{!-- This is a handlebars template for PostgreSQL docker compose yaml file --}}
# This file provides an example on how to start the runtime with PostgreSQL.
# It is based on the configuration named {{Config}}.

services:
  mendix-app:
    image: eclipse-temurin:21-jdk
    container_name: mendix-app
    working_dir: /mendix
    volumes:
      - ../app:/mendix/app
      - ../bin:/mendix/bin
      - ../etc:/mendix/etc
      - ../lib:/mendix/lib
    environment:
      - MX_LOG_LEVEL=info
      - M2EE_ADMIN_PASS=${M2EE_ADMIN_PASS}
{{#if DbUrl}}
      - RUNTIME_PARAMS_DATABASEHOST=postgres-db:{{DbPort}}
{{/if}}
    ports:
{{#each AppPorts}}
      - "{{Port}}:{{Port}}"
{{/each}}
    command: ["./bin/start", "etc/{{Config}}"]
    depends_on:
      - postgres-db

  postgres-db:
    image: postgres:15
    restart: always
    environment:
{{#if DbName}}
      POSTGRES_DB: {{DbName}}
{{/if}}
{{#if DbUser}}
      POSTGRES_USER: {{DbUser}}
{{/if}}
{{#if DbPassword}}
      POSTGRES_PASSWORD: {{DbPassword}}
{{/if}}
    volumes:
      - pgdata:/var/lib/postgresql/data
{{#if DbPort}}
    ports:
      - "5432:{{DbPort}}"
{{/if}}
volumes:
  pgdata:
