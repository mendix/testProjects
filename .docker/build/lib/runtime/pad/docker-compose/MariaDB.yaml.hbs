{{!-- This is a handlebars template for MariaDB/MySQL docker compose yaml file --}}
# This file provides an example on how to start the runtime with MariaDB/MySQL.
# It is based on the configuration named {{Config}}.

services:
  mendix-app:
    image: eclipse-temurin:21-jdk
    container_name: mendix-app
    working_dir: /mendix
    volumes:
      - ../app:/mendix/app
      - ../bin:/mendix/bin
      - ../etc:/mendix/etc
      - ../lib:/mendix/lib
    environment:
      - MX_LOG_LEVEL=info
      - M2EE_ADMIN_PASS=${M2EE_ADMIN_PASS}
{{#if DbUrl}}
      - RUNTIME_PARAMS_DATABASEHOST=maria-db:{{DbPort}}
{{/if}}
    ports:
{{#each AppPorts}}
      - "{{Port}}:{{Port}}"
{{/each}}
    command: ["./bin/start", "etc/{{Config}}"]
    depends_on:
      - maria-db

  maria-db:
    image: mariadb:11.8-ubi
    restart: always
    environment:
{{#if DbName}}
      MARIADB_DATABASE: {{DbName}}
{{/if}}
{{#if DbUser}}
      MARIADB_USER: {{DbUser}}
{{/if}}
{{#if DbPassword}}
      MARIADB_PASSWORD: {{DbPassword}}
{{/if}}
    volumes:
      - mdbdata:/var/lib/mysql
{{#if DbPort}}
    ports:
      - "3306:{{DbPort}}"
{{/if}}
volumes:
  mdbdata:
