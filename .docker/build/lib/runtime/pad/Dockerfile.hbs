{{!-- This is a handlebars template for a (default) Docker file --}}
# This file provides an example on how to start the runtime in Docker.
# It is based on the configuration named {{Config}}.

FROM eclipse-temurin:21-jdk

# Set working directory
WORKDIR /mendix

# Copy Mendix app files into the image
COPY ./app ./app
COPY ./bin ./bin
COPY ./etc ./etc
COPY ./lib ./lib

# Environment variables
ENV MX_LOG_LEVEL=info
ENV M2EE_ADMIN_PASS=${M2EE_ADMIN_PASS}

# Expose ports
{{#each AppPorts}}
EXPOSE {{Port}}
{{/each}}

# Start command
CMD ["./bin/start", "etc/{{Config}}"]
